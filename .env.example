# === DATABASE ===
POSTGRES_USER=smartqueue
POSTGRES_PASSWORD=smartqueue123
AUTH_DB=auth_db
QUEUE_DB=queue_db
NOTIF_DB=notification_db
ANALYTICS_DB=analytics_db
ADMIN_DB=admin_db

# === REDIS ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# === KAFKA ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# === JWT ===
JWT_SECRET=a-very-long-secret-key-that-is-at-least-512-bits-long-for-HS512-signing-algorithm
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# === OAUTH2 (Google) ===
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === NOTIFICATIONS ===
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# === SERVICES ===
AUTH_SERVICE_URL=http://auth-service:8081
QUEUE_SERVICE_URL=http://queue-service:8082
NOTIF_SERVICE_URL=http://notification-service:8083
ANALYTICS_SERVICE_URL=http://analytics-service:8084
ADMIN_SERVICE_URL=http://admin-service:8085
